# --- Server ---
PORT=4000
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/rag_platform

# --- JWT ---
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- ChromaDB ---
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=rag_chunks

# --- Embeddings (local CPU, no API cost) ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Groq (LLM generation, free tier) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K=4

# --- Redis ---
REDIS_URL=redis://localhost:6379
QUERY_CACHE_TTL_SECONDS=300

# --- OpenSearch (BM25 keyword search) ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=rag_chunks

# --- Hybrid retrieval fusion ---
RRF_K=60
RRF_CANDIDATE_POOL=10

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Cost tracking (estimates only) ---
COST_PER_1K_PROMPT_TOKENS=0.05
COST_PER_1K_COMPLETION_TOKENS=0.08
